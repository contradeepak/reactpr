      "isDeleted": false,
      "boundElements": null,
      "updated": 1765190283435,
      "link": null,
      "locked": false,
      "text": "Same in the DOM:\nbutton → div → body → document\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same in the DOM:\nbutton → div → body → document\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
